# Copy to .env.local and fill in. The real values live in Vercel's env settings.
#
# The Supabase URL and publishable key are safe to expose (they are shipped to the browser
# and are protected by row-level security and the allowlist). The service-role key is NOT
# used anywhere in this app and must never be added here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who may sign in is no longer configured here. It moved into the `members` table in
# Supabase on 2026-09-01, so access is granted in the admin screen at /admin rather than by
# editing an environment variable and redeploying, and each person carries a role
# (viewer / user / admin) rather than just being in or out. See site/lib/members.ts.
#
# FLIGHTDECK_ALLOWED_DOMAINS and FLIGHTDECK_ALLOWED_EMAILS are retired. Nothing reads them,
# and they can be deleted from the Vercel project.

# Live calendar, the fastest source. Without these /app/week falls back to the Supabase
# store, then to .calendar/events.json, and says on the page which one it used.
#
# One Entra app registration in the Oolio tenant, delegated scopes `Calendars.Read` and
# `offline_access`, no directory read. This is the same registration the V1 scope doc asks
# IT for (prerequisite 2); the calendar scopes are an addition to that ask, not a second one.
# GRAPH_REFRESH_TOKEN is minted once by hand with the auth-code flow and then reused.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=

# Overrides Australia/Melbourne. Any IANA zone name.
FLIGHTDECK_TIMEZONE=
