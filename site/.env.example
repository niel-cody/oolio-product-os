# Copy to .env.local and fill in. The real values live in Vercel's env settings.
#
# The Supabase URL and publishable key are safe to expose (they are shipped to the browser
# and are protected by row-level security and the allowlist). The service-role key is NOT
# used anywhere in this app and must never be added here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who may pass the /app/* gate. Both gates must pass: an allowed domain AND an explicit
# address. An empty FLIGHTDECK_ALLOWED_EMAILS denies everyone, on purpose.
FLIGHTDECK_ALLOWED_DOMAINS=oolio.com
FLIGHTDECK_ALLOWED_EMAILS=
